
### POST - CREATE
POST http://localhost:3000/tasks
Content-Type: application/json

{
  "judul": "Pengujian Persistensi PostgreSQL",
  "deskripsi": "Memastikan data tetap tersimpan setelah server restart",
  "matakuliah": "Pemrograman Web",
  "deadline": "2026-11-30",
  "prioritas": "tinggi",
  "status": "belum-selesai"
}

### GET - FIND ALL
GET http://localhost:3000/tasks

### GET - FIND ONE
GET http://localhost:3000/tasks/1

### PATCH - UPDATE
PATCH http://localhost:3000/tasks/1
Content-Type: application/json

{
  "status": "sedang-dikerjakan"
}

### DELETE - REMOVE
DELETE http://localhost:3000/tasks/1

### ERROR - NOT FOUND
GET http://localhost:3000/tasks/999

### ERROR - INVALID DATA
POST http://localhost:3000/tasks
Content-Type: application/json

{
  "judul": "Tugas Invalid",
  "deskripsi": "Pengujian validasi",
  "matakuliah": "Pemrograman Web",
  "deadline": "2026-11-25",
  "prioritas": "darurat",
  "status": "belum-selesai"
}
